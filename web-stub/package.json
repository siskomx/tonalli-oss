{
  "name": "tonalli-web-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/collect-ui-notices.mjs && node scripts/check-map-assets.mjs && vite build && node scripts/check-ui-build.mjs",
    "prepare:maps": "python ../scripts/prepare-map-assets.py",
    "test:maps:browser": "node scripts/check-map-browser.mjs",
    "test:articles:browser": "node --test tests/e2e/malicious.spec.mjs",
    "test:articles:errors": "node --test tests/e2e/article-errors.spec.mjs",
    "test:routes:lifetime": "node --test tests/e2e/departing-route.spec.mjs",
    "test:react:browser": "node --test tests/e2e/react-functional.spec.mjs",
    "test:perf": "vitest run --config vitest.config.js tests/performance",
    "test:ui": "vitest run --config vitest.config.js tests/ui",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "3.36.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-virtual": "3.14.26",
    "@uppy/core": "5.2.0",
    "@uppy/dashboard": "5.1.0",
    "@uppy/locales": "5.1.0",
    "@uppy/react": "5.1.1",
    "maplibre-gl": "4.7.1",
    "pdfjs-dist": "6.5.438",
    "plyr": "3.8.5",
    "pmtiles": "4.4.0",
    "qrcode-generator": "1.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "remark-gfm": "4.0.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@protomaps/basemaps": "5.7.0",
    "@tailwindcss/vite": "4.3.5",
    "playwright-core": "1.65.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
