<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false" android:usesCleartextTraffic="false" android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">
        <provider android:name=".update.UpdateProvider" android:authorities="${applicationId}.update"
            android:exported="false" android:grantUriPermissions="true" />
        <service android:name=".mesh.RadioService" android:exported="false" android:foregroundServiceType="connectedDevice" />
        <activity android:name=".mesh.RadioPermissionActivity" android:exported="false" />
        <service android:name=".music.MusicService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".downloads.NearbyCopyService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".index.SearchPreparationService" android:exported="false" android:foregroundServiceType="dataSync" />
        <service android:name=".tv.TvService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started TV mode serving only explicitly selected managed media over local HTTP and UPnP AV; ongoing Stop action; no background auto-start." />
        </service>
        <service android:name=".downloads.ContentDownloadService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" android:process=":downloads" />
        <service android:name=".downloads.MapDownloadService" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" android:process=":mapdownloads" />
        <service android:name=".lan.LanService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started offline installed-pack sharing to paired devices on local Wi-Fi or a local-only hotspot; ongoing Stop action; no background auto-start." />
        </service>
        <activity android:name=".lan.LanProbeActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".ai.AiProbeActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".web.WebProbeActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".notes.NotesProbeActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".benchmark.BenchmarkActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".saf.RemovableProbeActivity" android:exported="false" android:launchMode="singleTask" />
        <activity android:name=".reader.OpenContentActivity" android:exported="false" />
        <activity android:name=".downloads.OpenMapActivity" android:exported="false" />
        <activity android:name=".media.MediaImportActivity" android:exported="false" />
        <activity android:name=".reader.ReaderIndexActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
